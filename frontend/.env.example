# 설정 참고용. 기존 .env를 덮어쓰지 마세요. 프로세스 환경변수로도 설정할 수 있습니다.

# 백엔드 (C)
BACKEND_API_URL=http://127.0.0.1:8000/api/v1
FRONTEND_USE_MOCK=false
# 전신 사진 백엔드가 통합되기 전까지 비활성화
FRONTEND_BODY_PHOTO_ENABLED=false
# 검증에서는 두 서버 모두 .env 자동 로딩 생략
# FITJANG_SKIP_DOTENV=1

# 착샷 서버 (FASHN VTON v1.5) — 키는 시아에게 받기
TRYON_API_URL=
TRYON_API_KEY=
