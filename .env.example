# Copy to .env (copy .env.example .env). Never commit .env
APP_ENV=dev
LOG_LEVEL=INFO

# Docker publishes PostgreSQL on IPv4 loopback only.
DATABASE_URL=postgresql+psycopg://fitjang:fitjang@127.0.0.1:5432/fitjang
TEST_DATABASE_URL=postgresql+psycopg://fitjang:fitjang@127.0.0.1:5432/fitjang_test

# Generated by scripts/dev.ps1 setup or python scripts/init_auth_secret.py
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# Retry unfinished file cleanup after DB deletion. 0 disables the background worker.
STORAGE_DELETE_RETRY_SECONDS=30

# Vision: mock | local. Recommendation: mock | local | openai
VISION_PROVIDER=mock
RECOMMENDER_PROVIDER=mock
# open_meteo: location-based current temperature, no key needed (non-commercial API).
# manual: only explicitly supplied temperature; GET /weather asks for manual input.
WEATHER_PROVIDER=open_meteo
WEATHER_TIMEOUT_SEC=3
WEATHER_CACHE_TTL_SEC=300
WEATHER_CACHE_MAX_ENTRIES=256
VISION_TIMEOUT_SEC=20
RECOMMEND_TIMEOUT_SEC=30

LLM_API_KEY=
# OPENAI_API_KEY takes precedence over legacy LLM_API_KEY. Keep keys on backend only.
# Select RECOMMENDER_PROVIDER=openai to rank A's candidates with GPT; failures fall back locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SEC=6
OPENAI_MAX_OUTPUT_TOKENS=1200
# Reserved for a future keyed weather provider; Open-Meteo does not use this value.
WEATHER_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SERVE_FRONTEND=false
SIGNUP_INVITE_CODE=
